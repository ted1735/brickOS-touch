rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }

    match /tracks/{trackId} {
      allow read, write: if true;
    }

    match /composition_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /sound_presets/{presetId} {
      allow read, write: if true;
    }

    match /session_snapshots/{snapshotId} {
      allow read, write: if true;
    }

    match /whiteboard_canvases/{canvasId} {
      allow read, write: if true;
    }
  }
}
