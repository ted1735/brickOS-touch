{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "collections": {
    "tracks": {
      "description": "brickOS music tracks, lyrics, Suno prompts, version history, and audit records",
      "fields": {
        "id": { "type": "string", "description": "Unique Track Identifier (e.g. TRK-01 or UUID)" },
        "ep": { "type": "string", "description": "EP Suite grouping" },
        "title": { "type": "string", "description": "Track title" },
        "status": { "type": "string", "description": "Kanban pipeline stage" },
        "genre": { "type": "string", "description": "Music genre and style classification" },
        "bpm": { "type": "number", "description": "Tempo in beats per minute" },
        "key": { "type": "string", "description": "Musical key" },
        "vocal": { "type": "string", "description": "Vocal artist or archetype" },
        "vocalCast": { "type": "string", "description": "Detailed vocal casting description" },
        "thesis": { "type": "string", "description": "Theological or thematic concept thesis" },
        "sunoPrompt": { "type": "string", "description": "Suno style prompt generation string" },
        "negativePrompt": { "type": "string", "description": "Excluded sonic artifacts and negative prompt" },
        "engineSliders": { "type": "object", "description": "Suno v5.5 engine sliders config" },
        "lyrics": { "type": "string", "description": "Full song lyrics with structural meta-tags" },
        "versions": { "type": "array", "description": "Immutable version snapshot history" },
        "auditHistory": { "type": "array", "description": "Gemini theological & lyrical audit review records" },
        "selahPrayed": { "type": "boolean", "description": "24h Selah prayer status" },
        "notes": { "type": "string", "description": "Production or engineer notes" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "composition_sessions": {
      "description": "Saved track composition sessions, workspace snapshots, lyric revisions, and active sonic configurations in brickOS Studio",
      "fields": {
        "id": { "type": "string", "description": "Unique session ID (e.g. SES-01 or UUID)" },
        "name": { "type": "string", "description": "Human-readable session title or workflow description" },
        "trackId": { "type": "string", "description": "Associated Track Identifier" },
        "trackTitle": { "type": "string", "description": "Track title at time of session" },
        "ep": { "type": "string", "description": "EP suite grouping" },
        "description": { "type": "string", "description": "Session production notes and intent" },
        "activeTab": { "type": "string", "description": "Workspace tab active during session" },
        "tags": { "type": "array", "description": "Filter and categorization tags" },
        "isPinned": { "type": "boolean", "description": "Pinned status for quick access" },
        "color": { "type": "string", "description": "Visual theme color tag" },
        "snapshot": { "type": "object", "description": "Complete frozen state of the track (lyrics, Suno prompts, engine sliders, BPM, key, vocalCast, status, versions count)" },
        "createdAt": { "type": "string", "description": "ISO timestamp when session was created" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last session update" }
      }
    },
    "sound_presets": {
      "description": "Custom and factory sound presets for the Suno 4-block engine, including style prompts, artifact exclusions, engine slider weights, and vocal casting",
      "fields": {
        "id": { "type": "string", "description": "Unique preset ID" },
        "name": { "type": "string", "description": "Sound preset title" },
        "category": { "type": "string", "description": "Genre / vibe category tag" },
        "description": { "type": "string", "description": "Detailed sound and production description" },
        "vocalCast": { "type": "string", "description": "Recommended vocal archetype casting" },
        "sunoPrompt": { "type": "string", "description": "Block 2 style prompt" },
        "negativePrompt": { "type": "string", "description": "Block 3 excluded styles" },
        "engineSliders": { "type": "object", "description": "Block 4 engine sliders (weirdness, styleInfluence, voiceAudio)" },
        "targetBpm": { "type": "number", "description": "Recommended BPM tempo" },
        "targetKey": { "type": "string", "description": "Recommended musical key" },
        "tags": { "type": "array", "description": "Search and filter tags" },
        "isFavorite": { "type": "boolean", "description": "Favorite preset bookmark" },
        "isFactory": { "type": "boolean", "description": "Whether this is a built-in factory preset" },
        "author": { "type": "string", "description": "Preset author or engineer name" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "session_snapshots": {
      "description": "Periodically saved session snapshots capturing frozen state of all DAW tracks, stems, effects chains, sound presets, and workspace point-in-time recovery data",
      "fields": {
        "id": { "type": "string", "description": "Unique snapshot identifier (e.g. SNAP-UUID or timestamp)" },
        "sessionId": { "type": "string", "description": "Associated Composition Session ID" },
        "trackId": { "type": "string", "description": "Associated Track Identifier" },
        "trackTitle": { "type": "string", "description": "Track title at snapshot time" },
        "ep": { "type": "string", "description": "EP Suite grouping" },
        "timestamp": { "type": "string", "description": "ISO timestamp when snapshot was captured" },
        "label": { "type": "string", "description": "User label or auto-save descriptor" },
        "trigger": { "type": "string", "description": "Trigger type: 'auto' | 'manual' | 'preset_change' | 'milestone'" },
        "dawTracks": { "type": "object", "description": "Frozen state of all DAW tracks, stems, volumes, pans, mute, solo, and trims" },
        "effects": { "type": "object", "description": "Frozen state of DAW effects rack (EQ, compressor, reverb, saturation, stereo width)" },
        "presets": { "type": "object", "description": "Frozen state of active sound preset and Suno engine sliders" },
        "workspace": { "type": "object", "description": "Frozen workspace state (activeTab, status, BPM, musical key)" },
        "notes": { "type": "string", "description": "Optional engineer notes for this snapshot" },
        "createdAt": { "type": "string", "description": "ISO timestamp when snapshot was created" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    }
  }
}
